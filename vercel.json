{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@2.0.0"
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "api/webhook.js"
    },
    {
      "src": "/api/send-message",
      "dest": "api/send-message.js"
    },
    {
      "src": "/api/get-location",
      "dest": "api/get-location.js"
    },
    {
      "src": "/api/get-weather",
      "dest": "api/get-weather.js"
    },
    {
      "src": "/api/get-html",
      "dest": "api/get-html.js"
    },
    {
      "src": "/api/trigger-weather-update",
      "dest": "api/trigger-weather-update.js"
    },
    {
      "src": "/api/ably-token",
      "dest": "api/ably-token.js"
    },
    {
      "src": "/api/send-notification",
      "dest": "api/send-notification.js"
    }
  ],
  "crons": [
    {
      "path": "/api/trigger-weather-update",
      "schedule": "0 0 * * *"
    }
  ]
}
